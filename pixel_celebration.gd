var text := "LEVEL UP!"
var ink := Color("#ffe080")
var pixel_size := 6

func _ready() -> void:
	texture_filter=CanvasItem.TEXTURE_FILTER_NEAREST
	queue_redraw()

func _draw() -> void:
	var clean := text.to_upper()
	var advance := pixel_size*6
	var width := clean.length()*advance-pixel_size
	var start_x := -width*0.5
	for index in clean.length():
		var character := clean.substr(index,1)
		if character==" ": continue
		var rows: Array = GLYPHS.get(character,GLYPHS["!"])
		for row in rows.size():
			for column in 5:
				if rows[row][column]=="1":
					var p:=Vector2(start_x+index*advance+column*pixel_size,row*pixel_size)
					draw_rect(Rect2(p+Vector2(-2,2),Vector2(pixel_size+2,pixel_size+2)),Color("#33231f"))
					draw_rect(Rect2(p,Vector2(pixel_size,pixel_size)),ink)
